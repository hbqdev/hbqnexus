# Copy to .env and fill in real values. Never commit .env.
#
# .env is read by the API server (server/index.js) only. Despite the VITE_
# prefix, these are NOT client-side values and must never be referenced from
# anything under src/ - Vite inlines any import.meta.env.VITE_* it finds into
# the public bundle.

# Couchbase - stores the quote collections
VITE_COUCHBASE_URL=192.168.x.x
VITE_COUCHBASE_USERNAME=
VITE_COUCHBASE_PASSWORD=

# API Ninjas (https://api-ninjas.com) - used by the quote import scripts
VITE_NINJA_API_KEY=

# API server port (defaults to 3000)
PORT=3000
